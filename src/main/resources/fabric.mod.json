{
	"schemaVersion": 1,
	"id": "invmanager",
	"version": "${version}",
	"name": "Inventory Manager",
	"description": "Sort inventories, deposit items into nearby storage, and recover materials, enchantments and XP at eleven Uncrafter Plus workstations.",
	"authors": ["zrandrews"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["io.github.zrandrews.invmanager.InvManagerMod", "dev.uncrafter.UncrafterPlus"]
	},
	"mixins": ["invmanager.mixins.json"],
	"breaks": { "uncrafter_plus": "*" },
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
